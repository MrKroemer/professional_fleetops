# =============================================================================
# FleetOps — Gestão de Frotas Locadas (Proyfe Brasil)
# Copie este arquivo para `.env` e ajuste os valores. NUNCA versione o `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
# Troque obrigatoriamente em qualquer ambiente que não seja a sua máquina.
POSTGRES_PASSWORD=fleetops_dev_only
# Porta exposta no host para acesso via cliente SQL (dentro da rede Docker é sempre 5432).
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Storage de objetos S3-compatível (MinIO) — fotos de book, checklists, CRLV
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=fleetops
MINIO_ROOT_PASSWORD=fleetops_dev_only
MINIO_BUCKET=fleetops-anexos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Perfil Spring ativo: `dev` (seed + logs verbosos) ou `prod`.
SPRING_PROFILES_ACTIVE=dev
# Porta publicada no host. Dentro da rede Docker o backend responde sempre na 8080.
# Ajuste se a porta já estiver ocupada por outro projeto na sua máquina.
BACKEND_PORT=8080

# Chave de assinatura dos JWT (HMAC-SHA256). Mínimo de 32 bytes.
# Gere com: openssl rand -base64 48
FLEETOPS_JWT_SECRET=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48
# Validade do access token (mantido apenas em memória no browser).
FLEETOPS_JWT_ACCESS_TTL=PT15M
# Validade do refresh token (cookie httpOnly).
FLEETOPS_JWT_REFRESH_TTL=P7D
# `true` marca o cookie de refresh como Secure (obrigatório em produção com HTTPS).
FLEETOPS_AUTH_COOKIE_SECURE=false

# Chave AES-GCM de 256 bits para cifrar credenciais de portais (RN-20).
# Gere com: openssl rand -base64 32
FLEETOPS_CRYPTO_KEY=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-32

# Origens permitidas para CORS (em produção o Nginx faz proxy e a lista fica vazia).
FLEETOPS_CORS_ORIGINS=http://localhost:5173

# Antecedência padrão, em dias, do alerta de prazo de indicação de condutor (RN-08).
FLEETOPS_ALERTAS_MULTA_ANTECEDENCIA_DIAS=5

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_PORT=8081
# Porta do dev server do Vite (apenas no perfil dev).
FRONTEND_DEV_PORT=5173

# -----------------------------------------------------------------------------
# Usuários seed (perfil `dev` apenas). Ignorados quando SPRING_PROFILES_ACTIVE=prod.
# -----------------------------------------------------------------------------
FLEETOPS_SEED_SENHA=Fleet@2026

# -----------------------------------------------------------------------------
# Administrador inicial (qualquer perfil)
#
# Usado UMA ÚNICA VEZ, quando o banco não tem nenhum usuário — é o que torna
# possível o primeiro login em uma instalação nova. Se já houver usuários, estas
# variáveis são ignoradas e nenhum dado existente é alterado.
#
# Depois do primeiro acesso: troque a senha pela interface e remova estas linhas.
# -----------------------------------------------------------------------------
FLEETOPS_ADMIN_EMAIL=
FLEETOPS_ADMIN_SENHA=
FLEETOPS_ADMIN_NOME=Administrador

# -----------------------------------------------------------------------------
# Identidade usada pelos containers de desenvolvimento
#
# No perfil `dev` o código-fonte é montado do host. Rodar como root deixaria os
# artefatos de build inacessíveis ao seu usuário. Descubra os seus valores com
# `id -u` e `id -g`.
# -----------------------------------------------------------------------------
DOCKER_UID=1000
DOCKER_GID=1000

# Migração do acervo das planilhas legadas (cadastros, contratos e operação mensal).
# Ligue apenas na primeira subida de uma instalação de produção; depois desligue.
# Em desenvolvimento já vem ligada pelo perfil `dev`.
FLEETOPS_CARGA_INICIAL=false
